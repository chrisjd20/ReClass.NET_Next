<Project ToolsVersion="14.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <OutputType>Exe</OutputType><AssemblyName>RuntimeWalkthrough</AssemblyName><TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion><PlatformTarget>x64</PlatformTarget><OutputPath>bin\</OutputPath>
    <AppOutputPath Condition="'$(AppOutputPath)' == ''">../../bin/Release/x64</AppOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Drawing" /><Reference Include="System.Windows.Forms" /><Reference Include="System" /><Reference Include="System.Core" /><Reference Include="System.Xml" /><Reference Include="System.Xml.Linq" />
    <Reference Include="System.IO.Compression" /><Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="ReClass.NET"><HintPath>$(AppOutputPath)/ReClass.NET.exe</HintPath><Private>true</Private></Reference>
    <Reference Include="Iced"><HintPath>$(AppOutputPath)/Iced.dll</HintPath><Private>true</Private></Reference>
    <Compile Include="RuntimeWalkthrough.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
